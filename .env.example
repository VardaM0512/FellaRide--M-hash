# Copy to .env and fill in. Never commit .env.

# --- Database (docker-compose) ---
POSTGRES_USER=fellaride
POSTGRES_PASSWORD=change-me

# --- API ---
# Local dev without Docker uses SQLite automatically; uncomment to point at another database.
# FELLARIDE_DATABASE_URL=postgresql+psycopg://fellaride:change-me@localhost:5432/fellaride
FELLARIDE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Login tokens: set a long random value in any shared deployment (e.g. `openssl rand -hex 32`).
# If empty, a random one is made at startup and everyone is signed out when the server restarts.
FELLARIDE_JWT_SECRET=change-me-to-64-random-characters
# Password of the seeded demo organiser account admin@demo.fellaride.app
FELLARIDE_DEMO_ADMIN_PASSWORD=fellaride-demo-admin
# One-tap demo sign-in as synthetic members (synthetic demo community only)
FELLARIDE_DEMO_LOGIN=true
# Optional operator key for scripts (X-Admin-Key header). Admins normally sign in instead.
FELLARIDE_ADMIN_KEY=

# --- Engine tuning (defaults shown) ---
FELLARIDE_NUDGE_BUDGET_PER_DAY=14
FELLARIDE_NUDGE_COOLDOWN_DAYS=2
FELLARIDE_MAX_DETOUR_KM=3.0
FELLARIDE_MAX_TIME_GAP_MIN=30
FELLARIDE_LEARNING_RATE=0.35

# --- Evaluator demo ---
# First start on an empty database: create a synthetic demo community and replay this many days (0 = off).
FELLARIDE_SEED_DEMO_DAYS=14
# Sign-ups without a join code join this community (DEMO2026 = the synthetic demo, so they show on its dashboard).
# Leave empty to put them in the open community instead.
FELLARIDE_DEFAULT_JOIN_CODE=DEMO2026
