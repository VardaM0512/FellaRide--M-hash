# Ready to run: copy this file to .env (copy .env.example .env), then: docker compose up -d --build
# Contains the team's real Supabase link and passwords on purpose, so anyone with repo access can run the app.

# --- Database ---
# Local Docker (docker-compose.yml) uses these for its own Postgres:
POSTGRES_USER=fellaride
POSTGRES_PASSWORD=change-me
# Hosted (Supabase): Connect -> Session pooler URI (port 5432). Change postgresql:// to postgresql+psycopg://
# and add ?sslmode=require at the end. When set, docker compose uses it instead of the local db container.
# Without this line, local dev without Docker uses SQLite.
FELLARIDE_DATABASE_URL=postgresql+psycopg://postgres.qexjvtpgrqozcpsfkgum:ssssureshhhh430@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- API ---
# Browser origins allowed to call the API: your Vercel URL in production (no trailing slash).
FELLARIDE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Login tokens: a long random value (python -c "import secrets;print(secrets.token_hex(32))").
# If empty, a random one is made at startup and everyone is signed out when the server restarts.
FELLARIDE_JWT_SECRET=fecd42018d4a1e2ca6d3f1d548c4b461ec00d275fc11f96cd53d4aa963a37eeb
# Operator key for admin scripts (X-Admin-Key header). Admins normally sign in instead.
FELLARIDE_ADMIN_KEY=fellaride-admin-2026

# --- Email (forgot-password links) ---
# Without FELLARIDE_SMTP_HOST the reset link is only written to the API's log (local testing).
# Gmail: host smtp.gmail.com, port 587, your address as user, and an app password (Google account -> Security).
FELLARIDE_SMTP_HOST=
FELLARIDE_SMTP_PORT=587
FELLARIDE_SMTP_USER=
FELLARIDE_SMTP_PASSWORD=
FELLARIDE_SMTP_FROM=
# The web app's address, used in the reset link (your Render web URL in production, no trailing slash).
FELLARIDE_APP_URL=http://localhost:5173

# --- Demo data ---
# On first start with an empty database, create a synthetic demo community and replay this many days.
# Production with real users: 0. Judge demo: 14.
FELLARIDE_SEED_DEMO_DAYS=14
# One-tap demo sign-in as synthetic members (only matters when demo data is seeded).
FELLARIDE_DEMO_LOGIN=true
# Password of the seeded demo organiser account admin@demo.fellaride.app (only when demo data is seeded).
FELLARIDE_DEMO_ADMIN_PASSWORD=8a7a273756ac056a5961276bc609912036837aa8f5e1f7de2c687d2164d7e1e9
# Sign-ups without a join code join this community (DEMO2026 = the synthetic demo). Empty = the open community.
FELLARIDE_DEFAULT_JOIN_CODE=DEMO2026

# --- Engine tuning (defaults shown) ---
FELLARIDE_NUDGE_BUDGET_PER_DAY=14
FELLARIDE_NUDGE_COOLDOWN_DAYS=2
FELLARIDE_MAX_DETOUR_KM=3.0
FELLARIDE_MAX_TIME_GAP_MIN=30
FELLARIDE_LEARNING_RATE=0.35
FELLARIDE_LEARNING_RATE_DECAY_UPDATES=1000
# Real communities only: random share of the nudge budget, and day clock following the calendar.
FELLARIDE_EXPLORE_SHARE=0.15
FELLARIDE_AUTO_ADVANCE_DAYS=true
