# Copy to .env.local (never commit it).
# Where the FellaRide API runs.
VITE_API_URL=http://localhost:8000
# The community to show. The auto-seeded synthetic demo community is 1.
VITE_TENANT_ID=1
# LOCAL DEMO ONLY: unlocks Next day, Simulate and the Proof page.
# Anything in a Vite env file ships inside the public bundle, so leave this empty in any deployed build.
VITE_ADMIN_KEY=
